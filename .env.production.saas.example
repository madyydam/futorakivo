# ==============================================================================
# KIVO — Petpooja-Grade Multi-Tenant Cloud SaaS Production Environment Config
# ==============================================================================

# Core Application Domain
SAAS_DOMAIN=kivo.cloud
APP_VERSION=1.0.0

# Central Database (PgBouncer connection for high concurrency)
POSTGRES_USER=kivoadmin
POSTGRES_PASSWORD=replace_with_ultra_secure_password_512bit
POSTGRES_DB=kivo_cloud_db
DATABASE_URL=postgresql://kivoadmin:replace_with_ultra_secure_password_512bit@pgbouncer:6432/kivo_cloud_db?sslmode=disable
DIRECT_URL=postgresql://kivoadmin:replace_with_ultra_secure_password_512bit@postgres:5432/kivo_cloud_db

# Redis Cache & WebSockets
REDIS_URL=redis://redis:6379

# SaaS Public Self-Serve Signup (Allows instant 14-day trials)
ALLOW_PUBLIC_SIGNUP=true

# Security & Sessions
JWT_SECRET=replace_with_random_64_character_hex_jwt_secret
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://kivo.cloud

# Super Admin Platform Console Access
SUPER_ADMIN_EMAILS=owner@futora.group,admin@futorakivo.com

# Payment Gateway (Razorpay / Cashfree / Stripe for SaaS Subscriptions)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Food Delivery Aggregator Webhook Signing Keys
ZOMATO_WEBHOOK_SECRET=zomato_live_relay_key
SWIGGY_WEBHOOK_SECRET=swiggy_live_relay_key
ONDC_GATEWAY_SUBSCRIBER_ID=kivo.futora.ondc

# Cloud Storage Backups (AWS S3 / Cloudflare R2)
S3_BACKUP_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BACKUP_BUCKET=kivo-saas-cloud-backups
S3_BACKUP_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
S3_BACKUP_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
S3_BACKUP_REGION=ap-south-1
